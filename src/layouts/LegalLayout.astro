---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import { renderMarkdown } from '../lib/markdown';
import { TYPOGRAPHY_BASELINE, SECTION_BODY_P } from '../lib/typography';

type Props = {
  title: string;
  content: string;
};

const { title, content } = Astro.props;

// Plain document register: a modest H1, numbered H2 clause headings in the
// body face, and tighter paragraph rhythm so long clauses scan easily.
const classes = {
  ...TYPOGRAPHY_BASELINE,
  h1: 'text-[clamp(2.25rem,3vw+1rem,3rem)] font-semibold leading-[1.02] tracking-[-0.028em] text-sand-12',
  h2: 'mt-14 text-[1.25rem] font-semibold leading-[1.3] tracking-[-0.012em] text-sand-12',
  p: `mt-4 ${SECTION_BODY_P}`,
  ul: 'mt-4 max-w-[68ch] space-y-2 list-disc list-outside pl-5',
};

const html = renderMarkdown(content, classes);
---

<BaseLayout title={title}>
  <PageHeader />
  <main class="px-6 pt-24 pb-12 sm:px-10 sm:pt-32">
    <div class="mx-auto grid max-w-480 grid-cols-[1fr_minmax(0,44rem)_3fr]">
      <div class="col-start-2">
        <a
          href="/"
          class="text-xs font-medium tracking-[0.12em] text-ink-11 uppercase transition-colors hover:text-ink-12"
        >
          &larr; Back to home
        </a>
        <!-- The paragraph directly after the H1 is the "Last updated" line;
             it reads as a metadata label rather than body copy. -->
        <article
          data-legal-document
          class="mt-12 [&>h1+p]:mt-6 [&>h1+p]:text-xs [&>h1+p]:font-medium [&>h1+p]:tracking-[0.12em] [&>h1+p]:text-sand-11 [&>h1+p]:uppercase"
          set:html={html}
        />
      </div>
    </div>
  </main>
  <PageFooter />
</BaseLayout>
