---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/font-selection.css';
import heroContent from '../content/hero.md?raw';
import { site } from '../content/site';
import { getShareHeadline } from '../lib/share-content';
import { SHARE_IMAGE_WIDTH, SHARE_IMAGE_HEIGHT } from '../lib/share-image';
import {
  DEFAULT_FONT_SELECTION,
  DEFAULT_FONT_STYLE,
} from '../lib/font-experiment';
import CloudflareWebAnalytics from '../components/CloudflareWebAnalytics.astro';
import ColorExperimentHead from '../components/ColorExperimentHead.astro';
import FontPicker from '../components/FontPicker.astro';
import FontExperimentHead from '../components/FontExperimentHead.astro';
import ColorVariantWidget from '../components/ColorVariantWidget.astro';
import {
  COLOR_TOKENS,
  DEFAULT_COLOR_STYLE,
  DEFAULT_COLOR_SELECTION,
} from '../lib/color-experiment';

type Props = {
  title: string;
  description?: string;
  colorExperiment?: boolean;
  shareImage?: string;
};

const {
  title,
  description = site.description,
  colorExperiment = false,
  shareImage = '/social/share-card.png',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, site.origin);
const shareImageUrl = new URL(shareImage, site.origin);
const shareImageAlt = `${site.name}. ${getShareHeadline(heroContent)}. ${site.shareByline}.`;
const showColorSwitcher =
  colorExperiment && import.meta.env.COLOR_SWITCHER_ENABLED === 'true';
---

<!doctype html>
<html
  lang="en"
  style={`${DEFAULT_FONT_STYLE}${colorExperiment ? `;${DEFAULT_COLOR_STYLE};${COLOR_TOKENS}` : ''}`}
  data-headline-font={DEFAULT_FONT_SELECTION.headlines}
  data-headline-weight={DEFAULT_FONT_SELECTION.weights[
    DEFAULT_FONT_SELECTION.headlines
  ]}
  data-body-font={DEFAULT_FONT_SELECTION.body}
  data-palette={colorExperiment ? DEFAULT_COLOR_SELECTION.palette : undefined}
  data-cream={colorExperiment ? DEFAULT_COLOR_SELECTION.cream : undefined}
  data-color-switcher={showColorSwitcher ? 'enabled' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="author" content="Christian Naths" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SHARE_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    {
      showColorSwitcher && (
        <>
          <ColorExperimentHead />
          <FontExperimentHead />
        </>
      )
    }
    {import.meta.env.PROD && <CloudflareWebAnalytics />}
    <Font cssVariable="--webfont-hanken-grotesk" />
    <Font cssVariable="--webfont-alice" preload={[{ style: 'normal' }]} />
    <Font
      cssVariable="--webfont-source-sans-3"
      preload={[{ style: 'normal' }]}
    />
    <Font cssVariable="--webfont-space-grotesk" />
    <Font cssVariable="--webfont-dm-mono" />
    <Font cssVariable="--webfont-spectral" />
    {
      showColorSwitcher && (
        <>
          <Font cssVariable="--webfont-amiri" />
          <Font cssVariable="--webfont-bona-nova" />
          <Font cssVariable="--webfont-open-sans" />
          <Font cssVariable="--webfont-lato" />
        </>
      )
    }
    <link
      rel="shortcut icon"
      type="image/png"
      href="data:image/png;base64,"
    />
  </head>
  <body class="bg-sand-2 text-sand-12 antialiased">
    <slot />
    {
      showColorSwitcher && (
        <div id="experiment-dock">
          <ColorVariantWidget />
          <FontPicker />
        </div>
      )
    }
  </body>
</html>

<style>
  #experiment-dock {
    position: fixed;
    z-index: 50;
    top: 50%;
    right: env(safe-area-inset-right, 0px);
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
</style>

<style is:global>
  @media (max-width: 639px) {
    html[data-color-switcher='enabled'] body {
      padding-right: calc(44px + env(safe-area-inset-right, 0px));
    }
  }
</style>
