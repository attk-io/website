---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

type Hue = 'sand' | 'ink' | 'sun' | 'teal' | 'ocean' | 'plum';

type Swatch = {
  step: number;
  oklch: string;
};

// Parse OKLCH values from global.css so the specimen always documents the
// live token values. Regex matches `--color-{hue}-{step}: oklch(...);`.
const cssPath = path.resolve('src/styles/global.css');
const cssSource = fs.readFileSync(cssPath, 'utf8');
const tokenPattern =
  /--color-(sand|ink|sun|teal|ocean|plum)-(\d+):\s*(oklch\([^)]+\))/g;

const swatchesByHue: Record<Hue, Swatch[]> = {
  sand: [],
  ink: [],
  sun: [],
  teal: [],
  ocean: [],
  plum: [],
};

for (const match of cssSource.matchAll(tokenPattern)) {
  const [, hue, step, oklch] = match;
  swatchesByHue[hue as Hue].push({ step: Number(step), oklch });
}

for (const hue of Object.keys(swatchesByHue) as Hue[]) {
  swatchesByHue[hue].sort((a, b) => a.step - b.step);
}

const scales: {
  name: Hue;
  label: string;
  description: string;
  swatches: Swatch[];
}[] = [
  {
    name: 'sand',
    label: 'Sand',
    description: 'Cool neutral ramp — tinted toward ink for cohesion',
    swatches: swatchesByHue.sand,
  },
  {
    name: 'ink',
    label: 'Ink',
    description: 'Dark fountain-pen blue-violet — deep, literary',
    swatches: swatchesByHue.ink,
  },
  {
    name: 'sun',
    label: 'Sun',
    description: 'Sunshine yellow — bright, warm, joyful',
    swatches: swatchesByHue.sun,
  },
  {
    name: 'teal',
    label: 'Teal',
    description: 'Petrol peacock — cool, modern, restrained',
    swatches: swatchesByHue.teal,
  },
  {
    name: 'ocean',
    label: 'Ocean',
    description: 'Electric cyan-blue — the alive thread',
    swatches: swatchesByHue.ocean,
  },
  {
    name: 'plum',
    label: 'Plum',
    description: 'Deep aubergine — commercial signature',
    swatches: swatchesByHue.plum,
  },
];

// Perfect Fourth (1.333) type scale — see `--text-*` tokens in global.css.
const typeScale: {
  token: string;
  px: string;
  role: string;
  weight: string;
  weightClass: string;
  sample: string;
}[] = [
  {
    token: 'text-display',
    px: '56–95 px · fluid',
    role: 'Hero headline',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'Software, done right.',
  },
  {
    token: 'text-title',
    px: '44–72 px · fluid',
    role: 'Page heading · h1',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'I build software for founders who need to get it right.',
  },
  {
    token: 'text-heading',
    px: '34–54 px · fluid',
    role: 'Section heading · h2',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'A decade of shipping products that last.',
  },
  {
    token: 'text-subhead',
    px: '28–40 px · fluid',
    role: 'Reserve subheading',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'Each engagement starts with a real conversation.',
  },
  {
    token: 'text-large',
    px: '24–30 px · fluid',
    role: 'In-body heading · h3',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'Short, focused build cycles.',
  },
  {
    token: 'text-lead',
    px: '23 px',
    role: 'Lead paragraph · h4',
    weight: 'Medium 500',
    weightClass: 'font-medium',
    sample:
      'A lead paragraph introduces a section in a slightly larger, lighter voice.',
  },
  {
    token: 'text-body',
    px: '17 px',
    role: 'Body copy',
    weight: 'Regular 400',
    weightClass: 'font-normal',
    sample:
      'Development happens in short, focused cycles. Each week you see tangible progress, written for you, not for engineers — clear, concise, and free of jargon.',
  },
  {
    token: 'text-small',
    px: '13 px',
    role: 'Eyebrows, metadata, captions',
    weight: 'Medium 500',
    weightClass: 'font-medium',
    sample: 'Ch. 03 · How it Works · Revised April 2026',
  },
  {
    token: 'text-caption',
    px: '10 px',
    role: 'Micro-labels',
    weight: 'Medium 500',
    weightClass: 'font-medium',
    sample: 'OKLCH · 12 steps · sand-1 paper',
  },
];
---

<BaseLayout title="Specimen — ATTK Foundations">
