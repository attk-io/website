<script>
  const toHex = (channel: number) =>
    Math.round(channel).toString(16).padStart(2, '0');

  // Round-trip the color through a canvas so the browser converts any
  // valid CSS color (oklch, rgb, hex, named) to an 8-bit sRGB pixel.
  const canvas = document.createElement('canvas');
  canvas.width = 1;
  canvas.height = 1;
  const ctx = canvas.getContext('2d');

  const toHexColor = (color: string): string | null => {
    if (!ctx) return null;
    ctx.clearRect(0, 0, 1, 1);
    ctx.fillStyle = '#000';
    ctx.fillStyle = color;
    ctx.fillRect(0, 0, 1, 1);
    const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
    return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
  };

  const swatches =
    document.querySelectorAll<HTMLButtonElement>('[data-swatch]');

  for (const swatch of swatches) {
    swatch.addEventListener('click', async () => {
      const computed = getComputedStyle(swatch).backgroundColor;
      const hex = toHexColor(computed);
      if (!hex) return;
      try {
        await navigator.clipboard.writeText(hex);
      } catch {
        return;
      }
      const feedback = swatch.querySelector<HTMLElement>(
        '[data-swatch-feedback]'
      );
      if (!feedback) return;
      feedback.style.opacity = '1';
      window.setTimeout(() => {
        feedback.style.opacity = '0';
      }, 900);
    });
  }
</script>

<script>
  import { READING_INK } from '../lib/color-experiment';
  const specimen = document.querySelector<HTMLElement>('#color-specimen');
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = 1;
  const context = canvas.getContext('2d');
  const luminance = (color: string) => {
    if (!context) return 0;
    context.fillStyle = color;
    context.fillRect(0, 0, 1, 1);
    const rgb = context.getImageData(0, 0, 1, 1).data;
    const linear = Array.from(rgb)
      .slice(0, 3)
      .map((value) => {
        const channel = value / 255;
        return channel <= 0.04045
          ? channel / 12.92
          : ((channel + 0.055) / 1.055) ** 2.4;
      });
    return linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722;
  };
  const updateContrast = () => {
    if (!specimen) return;
    const paper = getComputedStyle(document.documentElement)
      .getPropertyValue('--paper')
      .trim();
    for (const sample of specimen.querySelectorAll<HTMLElement>(
      '[data-contrast-text]'
    )) {
      const background = luminance(getComputedStyle(sample).backgroundColor);
      const ratio = (value: number) =>
        (Math.max(value, background) + 0.05) /
        (Math.min(value, background) + 0.05);
      sample.style.color =
        ratio(luminance(READING_INK)) >= ratio(luminance(paper))
          ? READING_INK
          : paper;
    }
  };
  window.addEventListener('attk:colors-changed', updateContrast);
  updateContrast();
</script>

