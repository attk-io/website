---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COLOR_RAMPS, type Hue } from '../lib/color-experiment';

type Swatch = { step: number; oklch: string };
const scales: {
  name: Hue;
  label: string;
  description: string;
  swatches: Swatch[];
}[] = [
  {
    name: 'sand',
    label: 'Paper',
    description: 'Cream paper through to deep reading ink',
    swatches: [],
  },
  {
    name: 'ink',
    label: 'Ink',
    description: 'Warm near-black — the primary reading and contrast color',
    swatches: [],
  },
  {
    name: 'sun',
    label: 'Accent',
    description: 'Selected red-orange — a small, deliberate pop',
    swatches: [],
  },
  {
    name: 'teal',
    label: 'Supporting tone',
    description: 'Sand or peach — quieter surfaces and highlights',
    swatches: [],
  },
];

for (const scale of scales) {
  scale.swatches = COLOR_RAMPS[scale.name].map((_, index) => ({
    step: index + 1,
    oklch: `var(--color-${scale.name}-${index + 1})`,
  }));
}

// Perfect Fourth (1.333) type scale — see `--text-*` tokens in global.css.
const typeScale: {
  token: string;
  px: string;
  role: string;
  weight: string;
  weightClass: string;
  sample: string;
}[] = [
  {
    token: 'text-display',
    px: '56–95 px · fluid',
    role: 'Hero headline',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'Software, done right.',
  },
  {
    token: 'text-title',
    px: '44–72 px · fluid',
    role: 'Page heading · h1',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'I build software for founders who need to get it right.',
  },
  {
    token: 'text-heading',
    px: '34–54 px · fluid',
    role: 'Section heading · h2',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'A decade of shipping products that last.',
  },
  {
    token: 'text-subhead',
    px: '28–40 px · fluid',
    role: 'Reserve subheading',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'Each engagement starts with a real conversation.',
  },
  {
    token: 'text-large',
    px: '24–30 px · fluid',
    role: 'In-body heading · h3',
    weight: 'Semibold 600',
    weightClass: 'font-semibold',
    sample: 'Short, focused build cycles.',
  },
  {
    token: 'text-lead',
    px: '23 px',
    role: 'Lead paragraph · h4',
    weight: 'Medium 500',
    weightClass: 'font-medium',
    sample:
      'A lead paragraph introduces a section in a slightly larger, lighter voice.',
  },
  {
    token: 'text-body',
    px: '17 px',
    role: 'Body copy',
    weight: 'Regular 400',
    weightClass: 'font-normal',
    sample:
      'Development happens in short, focused cycles. Each week you see tangible progress, written for you, not for engineers — clear, concise, and free of jargon.',
  },
  {
    token: 'text-small',
    px: '13 px',
    role: 'Eyebrows, metadata, captions',
    weight: 'Medium 500',
    weightClass: 'font-medium',
    sample: 'Ch. 03 · How it Works · Color exploration · October 2026',
  },
  {
    token: 'text-caption',
    px: '10 px',
    role: 'Micro-labels',
    weight: 'Medium 500',
    weightClass: 'font-medium',
    sample: '12 steps · Cream paper · Warm ink',
  },
];
