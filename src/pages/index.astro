---
import { marked, type Token } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageFooter from '../components/PageFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import PageSection from '../components/PageSection.astro';
import {
  parseMarkdownDocument,
  renderMarkdown,
  renderSectionContent,
} from '../lib/markdown';
import { TYPOGRAPHY_BASELINE } from '../lib/typography';

import heroContent from '../content/hero.md?raw';
import aboutContent from '../content/about.md?raw';
import yourVisionContent from '../content/your-vision.md?raw';
import theRightProductContent from '../content/the-right-product.md?raw';
import howItWorksContent from '../content/how-it-works.md?raw';
import ongoingSupportContent from '../content/ongoing-support.md?raw';
import experienceContent from '../content/experience.md?raw';
import whoThisIsForContent from '../content/who-this-is-for.md?raw';
import finalCtaContent from '../content/final-cta.md?raw';

const hero = renderSectionContent(heroContent, {
  ...TYPOGRAPHY_BASELINE,
  h1: 'max-w-[14ch] text-display font-semibold text-sand-12',
  // Default <p> is the mono lede descriptor. The CTA paragraph — a <p>
  // whose direct child is an <a> — is reset via has-[>a]: variants so it
  // reads as a standalone call-to-action rather than inheriting the lede.
  p: 'mt-8 max-w-[52ch] font-dm-mono text-body font-normal leading-[1.7] tracking-[0] text-sand-11 has-[>a]:mt-12 has-[>a]:max-w-none has-[>a]:font-hanken has-[>a]:leading-[1.6] has-[>a]:tracking-normal has-[>a]:text-sand-12',
  a: 'mt-2 inline-block bg-ocean-9 px-4 py-1 text-body font-medium text-[var(--on-accent)] no-underline hover:bg-ocean-12 hover:text-sand-1 transition-colors duration-150 underline underline-offset-4 decoration-[var(--on-accent)] hover:decoration-sand-1',
});

const about = renderSectionContent(aboutContent, TYPOGRAPHY_BASELINE);

const sections = [
  yourVisionContent,
  theRightProductContent,
  howItWorksContent,
  ongoingSupportContent,
  experienceContent,
  whoThisIsForContent,
].map((content) => {
  const section = renderSectionContent(content, TYPOGRAPHY_BASELINE);
  // Render decorative proof marks as masks so they inherit the live theme.
  const logos: Record<string, { mask: string; ratio: number }> = {
    'fundfilter.svg': { mask: 'fundfilter.svg', ratio: 61 / 59 },
    'tap-bio.svg': { mask: 'tap-bio-mask.svg', ratio: 1 },
    'yardly.svg': { mask: 'yardly.svg', ratio: 1 },
  };
  section.body = section.body.replace(
    /<img src="\/logos\/([^"]+)" alt="">/g,
    (image, name: string) => {
      const logo = logos[name];
      return logo
        ? `<span class="proof-logo" aria-hidden="true" style="width:${logo.ratio}em;mask-image:url('/logos/${logo.mask}')"></span>`
        : image;
    }
  );
  return section;
});

const finalCta = parseMarkdownDocument(finalCtaContent);
// Group standalone contact links without changing the content source.
const finalCtaTokens = marked.lexer(finalCta.body);
const isContactAction = (token: Token) =>
  token.type === 'paragraph' &&
  token.tokens?.length === 1 &&
  token.tokens[0].type === 'link';
const finalCtaHtml = renderMarkdown(
  finalCtaTokens
    .filter((token) => !isContactAction(token))
    .map((token) => token.raw)
    .join(''),
  {
    ...TYPOGRAPHY_BASELINE,
    p: 'mt-10 max-w-[68ch] font-dm-mono text-body leading-[1.7] text-sand-12',
  }
);
const finalCtaActionsHtml = renderMarkdown(
  finalCtaTokens
    .filter(isContactAction)
    .map((token) => token.raw.trim())
    .join(' '),
  {
    ...TYPOGRAPHY_BASELINE,
    p: 'mt-10 flex flex-wrap items-center gap-x-4 gap-y-3 font-dm-mono text-body leading-[1.7] text-sand-12',
    a: 'inline-block bg-sun-9 px-4 py-1 text-body font-medium text-[var(--on-accent)] no-underline hover:bg-sun-12 hover:text-sand-1 transition-colors duration-150 underline underline-offset-4 decoration-[var(--on-accent)] hover:decoration-sand-1',
  }
);
---

<BaseLayout
  colorExperiment
  title="ATTK Software"
  description="I help founders build and launch the right custom software. I take ownership of the technical side so you can focus on building your business."
>
  <PageHeader />
  <main class="overflow-clip bg-sand-1">
    <PageSection spacingClass="px-6 pt-32 pb-24 sm:px-10 sm:pt-44 sm:pb-32">
      <div set:html={hero.body} />
    </PageSection>
    {
      sections.map((section, index) => (
        <>
          <PageSection
            innerClass={
              index === 4
                ? 'col-span-2 max-w-[1140px]'
                : index === sections.length - 1
                  ? 'relative z-10 -m-8 bg-sand-1/80 p-8 sm:-m-12 sm:p-12'
                  : undefined
            }
            number={String(index === 0 ? 1 : index + 2).padStart(2, '0')}
            label={section.label}
          >
            <div
              class:list={[
                index === 2 && 'how-phases',
                index === 4 &&
                  '[&_h3]:flex [&_h3]:items-center [&_h3]:gap-4 [&_p]:max-w-none',
              ]}
              set:html={section.body}
            />
          </PageSection>
          {index === 0 && (
            <PageSection
              number="02"
              label={about.label}
              eyebrowClass="min-[780px]:col-span-2"
              innerClass="col-span-2 grid max-w-[1140px] grid-cols-1 gap-x-12 gap-y-6 min-[780px]:grid-cols-[2fr_minmax(280px,1fr)]"
            >
              <div
                class="min-[780px]:col-start-1 min-[780px]:row-start-2"
                set:html={about.body}
              />
              <figure class="relative max-w-[360px] min-[780px]:col-start-2 min-[780px]:row-start-2 min-[780px]:max-w-none">
                <img
                  src="/portrait.jpg"
                  alt="Christian Naths with his family"
                  width="512"
                  height="759"
                  loading="lazy"
                  class="aspect-square w-full object-cover object-top min-[780px]:absolute min-[780px]:inset-0 min-[780px]:aspect-auto min-[780px]:h-full"
                />
              </figure>
            </PageSection>
          )}
        </>
      ))
    }
    <section
      class="relative overflow-x-clip bg-sand-2 px-6 pt-24 sm:px-10 sm:pt-32"
    >
      <div class="mx-auto grid max-w-480 grid-cols-[1fr_minmax(0,44rem)_3fr]">
        <div
          class="relative col-span-2 col-start-2 grid max-w-[1140px] items-center px-8 py-16 min-[540px]:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] min-[540px]:gap-8 min-[540px]:p-0 lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] lg:gap-12"
        >
          <div
            class="contents min-[540px]:relative min-[540px]:z-10 min-[540px]:flex min-[540px]:aspect-square min-[540px]:max-w-[44rem] min-[540px]:flex-col min-[540px]:justify-center min-[540px]:py-16 sm:py-20 lg:px-12"
          >
            {
              finalCta.label && (
                <div class="mb-12 flex items-baseline gap-6">
                  <span class="text-small font-medium tracking-[0.14em] text-sand-12 uppercase">
                    {finalCta.label}
                  </span>
                  <span aria-hidden="true" class="h-px flex-1 bg-sand-12" />
                </div>
              )
            }
            {
              finalCta.quote && (
                <h2 class="max-w-[16ch] text-heading font-semibold text-sand-12">
                  {finalCta.quote}
                </h2>
              )
            }
            <div class="contents min-[540px]:block">
              <div class="contents [&>p]:order-1" set:html={finalCtaHtml} />
              <div
                data-final-cta-actions
                class="order-3 [&_a[href^=mailto]]:bg-transparent [&_a[href^=mailto]]:p-0 [&_a[href^=mailto]]:text-sand-12 [&_a[href^=mailto]]:decoration-sand-12 [&_a[href^=mailto]]:underline-offset-4 [&_a[href^=mailto]]:hover:bg-transparent [&_a[href^=mailto]]:hover:text-sand-12 [&_a[href^=mailto]]:hover:decoration-sand-12"
                set:html={finalCtaActionsHtml}
              />
            </div>
          </div>
          <figure
            class="order-2 mt-10 max-w-48 min-[540px]:order-first min-[540px]:mt-0 min-[540px]:max-w-64"
          >
            <img
              src="/portrait.jpg"
              alt="Christian Naths with his family"
              width="512"
              height="759"
              loading="lazy"
              class="h-auto w-full"
            />
          </figure>
        </div>
      </div>
    </section>
  </main>
  <PageFooter />
</BaseLayout>

<style>
  :global(.proof-logo) {
    display: inline-block;
    flex-shrink: 0;
    height: 1em;
    max-width: 45%;
    background-color: var(--color-sand-4);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
  }
</style>
