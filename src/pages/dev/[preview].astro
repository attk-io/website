---
import { site } from '../../content/site';

// This comparison page has no production paths and is omitted from the build.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'share' } }] : [];
}
const image = `/social/share-card.png?v=${Date.now()}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>ATTK share preview</title>
  </head>
  <body>
    <main>
      <header>
        <div>
          <h1>Share preview</h1><p>
            Local design checks · refresh after editing
          </p>
        </div>
        <button id="refresh">Refresh previews</button>
      </header>
      <section>
        <h2>Slack · compact card</h2>
        <p>
          Square center crop based on the supplied screenshot. This models that
          layout, not Slack’s image-selection rules.
        </p>
        <div class="slack">
          <a href={site.origin}>{site.origin}/</a>
          <div class="slack-card">
            <div class="slack-text">
              <strong>{site.title}</strong><div>{site.description}</div><span
                >{site.name}</span
              >
            </div>
            <img src={image} alt="Square crop of the ATTK share image" />
          </div>
        </div>
        <h3>Narrow view</h3>
        <div class="slack narrow">
          <div class="slack-card">
            <div class="slack-text">
              <strong>{site.title}</strong><div>{site.description}</div><span
                >{site.name}</span
              >
            </div>
            <img src={image} alt="Square crop at a smaller card size" />
          </div>
        </div>
      </section>
      <section>
        <h2>Wide image · current design</h2>
        <img
          class="wide"
          src={image}
          alt={`${site.name} logo. ${site.shareByline}.`}
        />
        <details>
          <summary>Compare the previous headline design</summary><img
            class="wide"
            src={`${image}&layout=headline`}
            alt="Previous headline share image"
          />
        </details>
      </section>
      <section>
        <h2>Other platform previews</h2>
        <p>
          <a href="http://localhost:4545/?url=/" target="_blank" rel="noopener"
            >Open localhost-og-preview separately</a
          >
        </p>
        <iframe
          src="http://localhost:4545/?url=/"
          title="Existing social preview tool"></iframe>
      </section>
    </main>
    <script>
      document
        .getElementById('refresh')
        ?.addEventListener('click', () => location.reload());
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: #f3f4f8;
    color: #1d1c1d;
    font:
      16px/1.5 system-ui,
      sans-serif;
  }
  main {
    max-width: 1200px;
    margin: auto;
    padding: 32px 20px;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  h1 {
    margin: 0;
    font-size: 28px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 20px;
  }
  h3 {
    margin-top: 28px;
    font-size: 16px;
  }
  p {
    margin: 0 0 20px;
    color: #666;
  }
  button {
    border: 0;
    background: #367345;
    color: white;
    padding: 12px 18px;
    border-radius: 6px;
    font: inherit;
    cursor: pointer;
  }
  section {
    margin-top: 28px;
    padding: 24px;
    border-radius: 12px;
    background: white;
  }
  .slack {
    padding: 12px;
    background: white;
    font-family: Arial, sans-serif;
  }
  .slack > a {
    display: block;
    margin-bottom: 10px;
    color: #1264a3;
    font-size: 20px;
    text-decoration: none;
  }
  .slack-card {
    display: flex;
    border: 1px solid #ddd;
    border-radius: 14px;
    overflow: hidden;
  }
  .slack-text {
    flex: 1;
    min-width: 0;
    padding: 18px;
    font-size: 17px;
    line-height: 1.4;
  }
  .slack-text strong {
    display: block;
    margin-bottom: 4px;
    font-size: 19px;
  }
  .slack-text div {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #454545;
  }
  .slack-text span {
    display: block;
    margin-top: 6px;
    color: #666;
  }
  .slack-card img {
    align-self: center;
    flex: 0 0 160px;
    width: 160px;
    height: 160px;
    object-fit: cover;
    object-position: center;
  }
  .narrow {
    max-width: 520px;
  }
  .narrow .slack-text {
    padding: 12px;
    font-size: 14px;
  }
  .narrow strong {
    font-size: 16px;
  }
  .narrow img {
    flex-basis: 120px;
    width: 120px;
    height: 120px;
  }
  .wide {
    display: block;
    width: 100%;
    height: auto;
  }
  details {
    margin-top: 18px;
  }
  summary {
    cursor: pointer;
    margin-bottom: 14px;
  }
  iframe {
    width: 100%;
    height: 1000px;
    border: 1px solid #ddd;
    border-radius: 8px;
  }
  @media (max-width: 600px) {
    main {
      padding: 20px 12px;
    }
    section {
      padding: 16px;
    }
    header {
      align-items: flex-start;
    }
    .slack {
      padding: 0;
    }
    .slack-card img {
      flex-basis: 110px;
      width: 110px;
      height: 110px;
    }
    .slack-text {
      padding: 12px;
      font-size: 14px;
    }
    .slack-text strong {
      font-size: 16px;
    }
  }
</style>
