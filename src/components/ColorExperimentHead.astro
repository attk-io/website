---
import {
  PALETTES,
  CREAMS,
  COLOR_STORAGE_KEY,
  DEFAULT_COLOR_SELECTION,
  resolveColorSelection,
} from '../lib/color-experiment';
---

<!-- Apply saved colors before paint; retired choices fall back to the defaults. -->
<script
  is:inline
  set:html={`
  {
    let saved = {};
    try { saved = JSON.parse(localStorage.getItem(${JSON.stringify(COLOR_STORAGE_KEY)}) || '{}'); } catch {}
    const selection = (${resolveColorSelection.toString()})(${JSON.stringify(PALETTES)}, ${JSON.stringify(CREAMS)}, saved, new URLSearchParams(location.search), ${JSON.stringify(DEFAULT_COLOR_SELECTION)});
    const palettes = ${JSON.stringify(PALETTES)}, creams = ${JSON.stringify(CREAMS)};
    const palette = palettes[selection.palette];
    const root = document.documentElement;
    root.dataset.palette = selection.palette;
    root.dataset.cream = selection.cream;
    for (const [name, value] of Object.entries({
      paper: creams[selection.cream].value,
      accent: palette.accent, support: palette.support, shade: palette.shade, 'on-accent': palette.onAccent,
    })) root.style.setProperty('--' + name, value);
    try { localStorage.setItem(${JSON.stringify(COLOR_STORAGE_KEY)}, JSON.stringify(selection)); } catch {}
  }
`}
/>

<script>
  import {
    PALETTES,
    CREAMS,
    COLOR_STORAGE_KEY,
    DEFAULT_COLOR_SELECTION,
    resolveColorSelection,
    applyColorSelection,
  } from '../lib/color-experiment';
  // A homepage open in another tab follows changes made in the specimen.
  window.addEventListener('storage', (event) => {
    if (document.documentElement.dataset.colorSwitcher !== 'enabled') return;
    if (event.key !== COLOR_STORAGE_KEY || !event.newValue) return;
    try {
      const selection = resolveColorSelection(
        PALETTES,
        CREAMS,
        JSON.parse(event.newValue),
        new URLSearchParams(),
        DEFAULT_COLOR_SELECTION
      );
      applyColorSelection(selection, false);
    } catch {
      /* Ignore invalid saved data. */
    }
  });
</script>
