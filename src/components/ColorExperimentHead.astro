---
import { PALETTES, CREAMS, COLOR_STORAGE_KEY } from '../lib/color-experiment';
---

<!-- Apply the saved colors before the page paints. URL choices take priority. -->
<script
  is:inline
  define:vars={{
    palettes: PALETTES,
    creams: CREAMS,
    storageKey: COLOR_STORAGE_KEY,
  }}
>
  // @ts-nocheck -- Astro injects the serialized theme values above at render time.
  const owns = (values, key) =>
    Object.prototype.hasOwnProperty.call(values, key);
  let saved = {};
  try {
    const parsed = JSON.parse(localStorage.getItem(storageKey) || '{}');
    if (parsed && typeof parsed === 'object') saved = parsed;
  } catch {
    /* Defaults and URL choices work without storage. */
  }
  const query = new URLSearchParams(location.search);
  const palette = [query.get('palette'), saved.palette, 'pop'].find((key) =>
    owns(palettes, key)
  );
  const cream = [query.get('cream'), saved.cream, 'original'].find((key) =>
    owns(creams, key)
  );
  const root = document.documentElement;
  root.dataset.palette = palette;
  root.dataset.cream = cream;
  for (const [name, value] of Object.entries({
    paper: creams[cream].value,
    accent: palettes[palette].accent,
    support: palettes[palette].support,
    shade: palettes[palette].shade,
    'on-accent': palettes[palette].onAccent,
  }))
    root.style.setProperty(`--${name}`, value);
  try {
    localStorage.setItem(storageKey, JSON.stringify({ palette, cream }));
  } catch {
    /* Storage may be blocked. */
  }
</script>

<script>
  import {
    PALETTES,
    CREAMS,
    COLOR_STORAGE_KEY,
    applyColorSelection,
  } from '../lib/color-experiment';
  // A homepage open in another tab follows changes made in the specimen.
  window.addEventListener('storage', (event) => {
    if (document.documentElement.dataset.colorSwitcher !== 'enabled') return;
    if (event.key !== COLOR_STORAGE_KEY || !event.newValue) return;
    try {
      const selection = JSON.parse(event.newValue);
      if (
        !selection ||
        !Object.hasOwn(PALETTES, selection.palette) ||
        !Object.hasOwn(CREAMS, selection.cream)
      )
        return;
      applyColorSelection(selection, false);
    } catch {
      /* Ignore invalid saved data. */
    }
  });
</script>
