---
type Props = {
  class?: string;
  number?: string;
  label: string;
};

const { class: className, number, label } = Astro.props;
---

<div class:list={['mb-12 flex items-baseline gap-6', className]}>
  <span class="text-small font-medium tracking-[0.14em] text-teal-11 uppercase">
    {number && <span>{number}</span>}
    {number && <span> · </span>}
    <span>{label}</span>
  </span>
  <span aria-hidden="true" class="h-px flex-1 bg-teal-11"></span>
</div>
