---
import CustomLogo02 from './CustomLogo02.astro';
const variants = import.meta.glob(
  '../../public/logos/qualifier-variants/*.svg',
  { query: '?raw', import: 'default', eager: true }
);
type Props = { className?: string; large?: boolean; reverse?: boolean };
const { className = '', large = false, reverse = false } = Astro.props;
---

<span
  class:list={['attack-logo', className, { large, reverse }]}
  role="img"
  aria-label="Attack Software"
>
  <span class="logo-version current-logo"><CustomLogo02 /></span>
  {
    Object.entries(variants).map(([path, svg]) => (
      <span
        class:list={[
          'logo-version qualifier-version',
          path.split('/').pop()?.replace('.svg', ''),
        ]}
        set:html={String(svg)}
      />
    ))
  }
</span>
<style>
  .attack-logo {
    display: inline-block;
    height: auto;
    font-size: 32px;
    color: #191613;
  }
  .large {
    font-size: clamp(56px, 12vw, 104px);
  }
  .reverse {
    color: #f2e2c8;
    --custom-square: rgb(242 226 200 / 35%);
  }
  .qualifier-version {
    width: 3.1432em;
  }
  .qualifier-version :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
