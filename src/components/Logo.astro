---
import CustomLogo from './CustomLogo.astro';
import CustomLogo02 from './CustomLogo02.astro';
type Props = { className?: string; large?: boolean; reverse?: boolean };
const { className = '', large = false, reverse = false } = Astro.props;
---

<span
  class:list={['attack-logo', className, { large, reverse }]}
  role="img"
  aria-label="Attack Software"
>
  <span class="custom-version custom-01"><CustomLogo /></span>
  <span class="custom-version custom-02"><CustomLogo02 /></span>
  <span class="type-version">
    <span class="wordmark"
      ><span>Attack</span><span class="square" aria-hidden="true"></span></span
    >
    <span class="qualifier" aria-hidden="true">Software</span>
  </span>
</span>
<style>
  .attack-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    height: auto;
    font-size: 32px;
    color: #191613;
  }
  .wordmark {
    display: inline-flex;
    position: relative;
    isolation: isolate;
    align-items: baseline;
    font-family: var(--logo-font);
    font-weight: var(--logo-weight);
    font-synthesis: none;
    line-height: 1.2;
    letter-spacing: var(--logo-tracking);
    white-space: nowrap;
  }
  .square {
    position: relative;
    display: inline-block;
    width: 0;
    height: 0;
  }
  .square::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: -0.205em;
    bottom: 0;
    width: 0.25em;
    height: 0.25em;
    background: #367345;
  }
  .qualifier {
    margin-top: 0.7em;
    font-family: var(--font-hanken);
    font-size: max(8px, 0.171em);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .large {
    font-size: clamp(56px, 12vw, 104px);
  }
  .reverse {
    color: #f2e2c8;
  }
  .reverse .square::after {
    background: rgb(242 226 200 / 35%);
  }
</style>
